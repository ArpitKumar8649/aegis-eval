# TokenForge Gateway Configuration
LLM_BASE_URL=https://tokenforge.ai.studio
LLM_API_KEY=your_tokenforge_api_key_here

# Model Selection (JUDGE_MODEL must strictly differ from SUBJECT_MODEL)
SUBJECT_MODEL=glm-5.3
JUDGE_MODEL=claude-sonnet-5.5

# Optional Concurrency and Timeout
MAX_CONCURRENCY=4
REQUEST_TIMEOUT_SECONDS=60
